# Supabase project URL from Project Settings / Connect
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred browser-safe key for new Supabase projects
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy alternative supported by the app. Use this instead of the publishable key if your project still uses anon keys.
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
